{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:mm:schema:v2:watch-diagnostic","title":"mm v2 watch diagnostic","type":"object","additionalProperties":false,
  "required":["schema","type","timestamp","message","backfill","fatal","redactions"],
